# ==============================================================================
# Havells Sambandh — Environment Configuration Template
# Copy this file to `.env` for local development. NEVER commit `.env` to Git.
# ==============================================================================

# --- Django Core ---
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=replace-with-a-long-cryptographically-random-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DEFAULT_TIMEZONE=Asia/Kolkata

# --- Database (PostgreSQL Primary) ---
# Standard URL format (used by Render & local PostgreSQL)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/havells_sambandh
DB_CONN_MAX_AGE=60

# --- Redis & Celery ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# --- JWT & Auth Security ---
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=7
AUTH_COOKIE_SECURE=False
AUTH_COOKIE_SAMESITE=Lax
AUTH_MAX_FAILED_LOGINS=5
AUTH_LOCKOUT_MINUTES=15

# --- CORS & Frontend Origin ---
FRONTEND_BASE_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Business Rule Defaults (Configurable) ---
ALLOW_SAME_DAY_BOOKING=False
AUTO_REVOKE_PRIOR_LINK=True
DEFAULT_SLOT_DURATION_MINUTES=60
DEFAULT_SLOT_CAPACITY=1
MAX_EXCEL_UPLOAD_MB=5

# --- Frontend (Vite) ---
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_APP_NAME=Havells Sambandh
